# LoveCats - Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais do Supabase

# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Obtenha essas credenciais em: Supabase Dashboard > Settings > API

# URL do projeto Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (anon key) - Pode ser exposta no frontend
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# =============================================================================
# SUPABASE SERVICE ROLE (BACKEND ONLY)
# =============================================================================
# ⚠️ NUNCA exponha esta chave no frontend!
# Use apenas em ambientes de servidor/backend seguros

# Chave de serviço (service_role key) - Apenas para operações admin
# SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# =============================================================================
# STORAGE BUCKETS
# =============================================================================
# Configurações dos buckets do Supabase Storage

# Bucket público para fotos dos gatinhos
VITE_STORAGE_BUCKET_FOTOS=fotos-gatinhos

# Bucket privado para documentos
VITE_STORAGE_BUCKET_DOCS=documentos-doacao

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Limite de upload de arquivos (em bytes)
VITE_MAX_FILE_SIZE=5242880  # 5 MB

# Número máximo de fotos por anúncio
VITE_MAX_FOTOS=1

# =============================================================================
# DEVELOPMENT / PRODUCTION
# =============================================================================

# Ambiente
NODE_ENV=development

# URL base da aplicação
VITE_APP_URL=http://localhost:5173

# =============================================================================
# OPCIONAL: INTEGRAÇÃO COM SERVIÇOS EXTERNOS
# =============================================================================

# Caso implemente geração de descrição com IA
# VITE_OPENAI_API_KEY=sua-chave-openai-aqui

# Integração com WhatsApp API (para notificações)
# WHATSAPP_API_TOKEN=seu-token-whatsapp-aqui

# Integração com serviço de email (Resend, SendGrid, etc.)
# EMAIL_API_KEY=sua-chave-email-aqui
# EMAIL_FROM=noreply@lovecats.com.br

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================
#
# 1. NUNCA commite o arquivo .env ao Git
# 2. Adicione .env ao .gitignore
# 3. Use diferentes arquivos .env para dev/staging/production
# 4. Rotacione as chaves periodicamente para segurança
# 5. Use o .env.example como template para novos desenvolvedores
#
# =============================================================================
