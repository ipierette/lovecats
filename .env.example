# =============================================================================
# LOVECATS — Template de Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com suas credenciais reais.
# Este arquivo (.env.example) É commitado no git — não coloque valores reais aqui.
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE
# Encontre em: Supabase Dashboard > Settings > API
# -----------------------------------------------------------------------------

SUPABASE_URL=https://seu-projeto.supabase.co

# Secret key (equivale à antiga service_role key) — SOMENTE BACK-END
SUPABASE_SECRET_KEY=

# Publishable key (equivale à antiga anon key) — pode ser usada no frontend
SUPABASE_PUBLISHABLE_KEY=


# -----------------------------------------------------------------------------
# SUPABASE STORAGE — nomes dos buckets
# Crie os buckets em: Supabase Dashboard > Storage
# -----------------------------------------------------------------------------

STORAGE_BUCKET_FOTOS=fotos-gatinhos
STORAGE_BUCKET_DOCS=documentos-doacao


# -----------------------------------------------------------------------------
# SEGURANÇA
# -----------------------------------------------------------------------------

# String aleatória para assinar tokens HMAC nos emails de confirmação de adoção.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HMAC_SECRET=


# -----------------------------------------------------------------------------
# EMAIL — Nodemailer + Gmail SMTP  (Fase 3)
# Guia de App Password: https://myaccount.google.com/apppasswords
# -----------------------------------------------------------------------------

EMAIL_USER=lovecats.doacao@gmail.com
EMAIL_APP_PASSWORD=


# -----------------------------------------------------------------------------
# GROQ AI — geração de descrição do anúncio (free tier: 14.400 req/dia)
# Obtenha em: https://console.groq.com → API Keys
# -----------------------------------------------------------------------------

GROQ_API_KEY=


# -----------------------------------------------------------------------------
# AMBIENTE
# -----------------------------------------------------------------------------

NODE_ENV=development
APP_URL=http://localhost:3000
